generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  TICKETED
  CANCELLED
  REFUNDED
  CHARGEBACK
}

enum RevenueType {
  FARE
  TAX
  FEE
  MCO
  CHARGEBACK
  REFUND
  ADJUSTMENT
}

enum ChargebackStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_RESET
}

enum SecurityEvent {
  LOGIN
  LOGOUT
  FAILED_LOGIN
  IP_BLOCKED
  SESSION_REVOKED
  PASSWORD_CHANGED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum IPRuleType {
  ALLOW
  DENY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

// ─── Booking transaction foundation (hybrid architecture) ──────────────────
// Booking remains the primary aggregate. Every booking currently has exactly
// one BookingTransaction (created automatically alongside the booking), but
// the model is shaped so a booking can later accumulate more (an exchange,
// a reissuance, etc.) without another breaking migration. See IMPLEMENTATION.md
// "Booking transaction architecture" for the full rationale.
enum TransactionType {
  NEW_BOOKING
  CANCEL_FOR_REFUND
  CANCEL_FOR_FUTURE_CREDIT
  EXCHANGE
  UPGRADE
  BAGGAGE_ADDON
  EXTRA_ADDON
  SEAT_ASSIGNMENT
  TICKET_REISSUANCE
}

enum TransactionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Company {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true)
  ipRestrictionEnabled Boolean @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users          User[]
  bookings       Booking[]
  revenue        Revenue[]
  activityLogs   ActivityLog[]
  securityLogs   SecurityLog[]
  notifications  Notification[]
  ipRules        IPRule[]
  airlines       Airline[]
  bookingClasses BookingClass[]
  providers      Provider[]
  cardProcessors CardProcessor[]
  callQueues     CallQueue[]
  savedViews     SavedView[]
  sessions       Session[]
  quickNotes     QuickNote[]
  bookingVerifications BookingVerification[]

  @@index([isActive])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  companyId    String
  email        String    @db.VarChar(320)
  passwordHash String    @db.VarChar(100)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  role         UserRole  @default(OPERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  version      Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company          Company        @relation(fields: [companyId], references: [id])
  sessions         Session[]
  createdBookings  Booking[]      @relation("BookingCreatedBy")
  assignedBookings Booking[]      @relation("BookingAssignedTo")
  activityLogs     ActivityLog[]
  notifications    Notification[]
  createdRevenue   Revenue[]
  savedViews       SavedView[]
  bookingNotes     BookingNote[]
  createdTransactions BookingTransaction[]
  quickNotes       QuickNote[]
  requestedVerifications BookingVerification[]
  uploadedAttachments Attachment[]

  @@unique([email, companyId])
  @@index([companyId])
  @@index([companyId, role])
  @@index([companyId, isActive])
  @@index([email])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  companyId        String
  refreshTokenHash String    @unique @db.VarChar(100)
  ipAddress        String    @db.VarChar(45)
  userAgent        String?   @db.VarChar(500)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("sessions")
}

enum PassengerType {
  ADULT
  CHILD
  INFANT_ON_SEAT
  INFANT_ON_LAP
}

enum ItineraryDirection {
  OUTBOUND
  RETURN
}

// Booking is now the top-level transaction record in the client's original
// CRM sense (BID-numbered), not a single-flight/single-passenger row. Flight,
// passenger, charge, and billing data all moved to dedicated child models —
// see ItinerarySegment, Passenger, Charge, BillingDetail below. This mirrors
// the client's "Create New Transaction" -> 7-step wizard structure exactly
// (Charges & Fees / Basic Details / Itinerary / Passengers / Billing &
// Payment / Special Details / Attachments), rather than the CRM's original
// single-flight assumption.
model Booking {
  id           String        @id @default(uuid())
  companyId    String
  // Human-facing sequential ID shown throughout the client's original CRM
  // (e.g. "BID1879"). A real Postgres sequence via @default(autoincrement()),
  // not a formatted string, so uniqueness is guaranteed at the DB level;
  // the "BID" prefix is applied when formatting for display/API responses.
  bidNumber    Int           @unique @default(autoincrement())
  reference    String        @db.VarChar(30)
  // Master reservation/confirmation number entered in "Basic Details"
  // (client's original CRM shows this separately from any per-segment
  // PNR/Confirmation on individual flights — see ItinerarySegment.pnrConfirmation).
  pnr          String?       @db.VarChar(20)
  // Entered once in the "Create New Transaction" pre-wizard step; the
  // authorization email is sent here. Distinct from any individual
  // passenger's own contact info in Passenger.
  customerEmail String       @db.VarChar(320)
  // "Bid Status" in the client's original CRM — reusing the existing
  // BookingStatus enum rather than inventing a parallel one; same states
  // (Pending/Confirmed/Ticketed/Cancelled/Refunded/Chargeback) apply.
  status        BookingStatus @default(PENDING)
  providerId    String
  callQueueId   String?
  assignedToId  String?
  createdById   String
  isUrgent      Boolean       @default(false)
  version       Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  company       Company               @relation(fields: [companyId], references: [id])
  provider      Provider              @relation(fields: [providerId], references: [id])
  callQueue     CallQueue?            @relation(fields: [callQueueId], references: [id])
  assignedTo    User?                 @relation("BookingAssignedTo", fields: [assignedToId], references: [id])
  createdBy     User                  @relation("BookingCreatedBy", fields: [createdById], references: [id])
  revenue       Revenue[]
  mco           MCO?
  bookingNotes  BookingNote[]
  chargebacks   Chargeback[]
  refunds       Refund[]
  transactions  BookingTransaction[]
  verifications BookingVerification[]
  charges       Charge[]
  segments      ItinerarySegment[]
  passengers    Passenger[]
  billing       BillingDetail?
  attachments   Attachment[]

  @@unique([reference, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, assignedToId])
  @@index([companyId, isUrgent])
  @@map("bookings")
}

// "Charges & Fees" step — one row per charge, each independently amount +
// currency, matching the per-row currency dropdown (USD/MXN/INR/EURO/CAD/ARS)
// shown in the screenshots. Booking-level totals are no longer stored
// directly; they're derived by summing these (see BookingsRepository).
model Charge {
  id          String   @id @default(uuid())
  bookingId   String
  chargeNumber Int
  amount      Int
  currencyId  String
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([bookingId, chargeNumber])
  @@index([bookingId])
  @@map("charges")
}

// "Itinerary Details" step — one row per flight leg. direction distinguishes
// Outbound vs Return (client's screenshots show at least an Outbound table;
// Round Trip / Multi City itinerary types imply Return/additional segments
// using the same shape). from/to are free-text as shown in the screenshots
// (e.g. "INDIA" / "USA") rather than an airport-code lookup, since no airport
// model/dropdown is evidenced anywhere in the screenshots.
model ItinerarySegment {
  id              String             @id @default(uuid())
  bookingId       String
  direction       ItineraryDirection @default(OUTBOUND)
  segmentNumber   Int
  airlineId       String
  flightNumber    String             @db.VarChar(20)
  fromText        String             @db.VarChar(100)
  toText          String             @db.VarChar(100)
  departureAt     DateTime
  arrivalAt       DateTime
  classId         String
  pnrConfirmation String?            @db.VarChar(30)
  createdAt       DateTime           @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id])
  airline Airline      @relation(fields: [airlineId], references: [id])
  class   BookingClass @relation(fields: [classId], references: [id])

  @@index([bookingId])
  @@map("itinerary_segments")
}

// "Passenger Details" step — one row per traveler, matching the client's
// Type/First/Middle/Last/DOB/Ticket Number table exactly.
model Passenger {
  id              String        @id @default(uuid())
  bookingId       String
  passengerNumber Int
  type            PassengerType
  firstName       String        @db.VarChar(100)
  middleName      String?       @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  dob             DateTime?
  ticketNumber    String?       @db.VarChar(50)
  createdAt       DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("passengers")
}

// "Billing & Payment" step. PCI-DSS-safe by construction, not by omission —
// see the accompanying implementation notes: the CRM UI still collects every
// field the client's original form shows (full card number, CVV, expiry),
// but only cardLast4 + expiry month/year ever reach this table. CVV is never
// transmitted past the browser and is never a column here at all — matching
// what the client's own "Itinerary Authorization" email already does
// (CVV Number: "..." — never actually shown/stored downstream either).
model BillingDetail {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  cardHolderName   String   @db.VarChar(200)
  cardProcessorId  String
  cardLast4        String   @db.VarChar(4)
  expiryMonth      Int
  expiryYear       Int
  billingEmail     String   @db.VarChar(320)
  billingContactNo String   @db.VarChar(30)
  billingStreet    String?  @db.VarChar(300)
  billingCity      String?  @db.VarChar(100)
  billingState     String?  @db.VarChar(100)
  billingZip       String?  @db.VarChar(20)
  billingCountry   String?  @db.VarChar(100)
  purchaseDate     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id])
  cardProcessor CardProcessor @relation(fields: [cardProcessorId], references: [id])

  @@map("billing_details")
}

// "Attachments" step — "Proofs" image uploads. Storage backend (S3 or
// equivalent) is not yet part of this project's infrastructure; fileUrl is
// expected to hold a URL/key from whatever object storage is configured —
// see implementation notes for what's still required here.
model Attachment {
  id           String   @id @default(uuid())
  bookingId    String
  fileUrl      String   @db.VarChar(1000)
  fileName     String   @db.VarChar(255)
  uploadedById String
  createdAt    DateTime @default(now())

  booking    Booking @relation(fields: [bookingId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([bookingId])
  @@map("attachments")
}

// BookingTransaction: the first step of the hybrid architecture described in
// IMPLEMENTATION.md. A Booking currently has exactly one BookingTransaction,
// created automatically when the booking is created (type = NEW_BOOKING).
// The model already supports many transactions per booking so a later
// "Create Revision" action can append TRANSACTION #2, #3, etc. without a
// further schema change — deferred deliberately, per the "current phase"
// scope, rather than implemented now.
//
// "Special Details" (step 6 of the wizard) reuses `metadata` below rather
// than a new model: the screenshots show it as empty/transaction-type-
// dependent ("No special fields required for this transaction type" for
// NEW_BOOKING), so a flexible Json bag — already present on this model —
// is the correct fit without inventing fields for transaction types that
// have no screenshot evidence.
model BookingTransaction {
  id                String            @id @default(uuid())
  bookingId         String
  transactionNumber Int
  transactionType   TransactionType
  status            TransactionStatus @default(COMPLETED)
  remarks           String?           @db.VarChar(1000)
  metadata          Json?
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  booking   Booking @relation(fields: [bookingId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@unique([bookingId, transactionNumber])
  @@index([bookingId])
  @@index([transactionType])
  @@map("booking_transactions")
}

// Client-facing booking verification (email link -> public review page ->
// digital signature). Deliberately a separate model rather than fields on
// Booking: a booking can be re-sent for verification, and each attempt needs
// its own token/expiry/signature/audit trail without overwriting history.
//
// tokenHash follows the exact same pattern as Session.refreshTokenHash: the
// raw token is put in the email link and never stored; only a bcrypt hash is
// persisted, compared via the same compareToken() util used by auth refresh.
//
// bookingSnapshot freezes the exact fields the client was shown/reviewed at
// send-time. If the booking is edited after the email goes out, verification
// (see BookingVerificationService.verify) is rejected rather than silently
// letting the client sign off on data that no longer matches — the CRM user
// must send a fresh verification request instead.
model BookingVerification {
  id               String             @id @default(uuid())
  bookingId        String
  companyId        String
  requestedById    String
  tokenHash        String             @unique @db.VarChar(100)
  status           VerificationStatus @default(PENDING)
  clientEmail      String             @db.VarChar(320)
  bookingSnapshot  Json
  // Vestigial: the original design captured a drawn signature. The client's
  // actual "Itinerary Authorization" screenshots show a single-click
  // "I Authorize" action instead, with the full booking/passenger/flight/
  // card breakdown already inline in the email — no signature capture.
  // Left nullable/unused rather than dropped, since removing a column is a
  // more invasive migration than simply not writing to it going forward.
  signatureDataUrl String?            @db.Text
  expiresAt        DateTime
  verifiedAt       DateTime?
  verifiedIp       String?            @db.VarChar(45)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  booking     Booking @relation(fields: [bookingId], references: [id])
  company     Company @relation(fields: [companyId], references: [id])
  requestedBy User    @relation(fields: [requestedById], references: [id])

  @@index([bookingId])
  @@index([companyId])
  @@index([status])
  @@map("booking_verifications")
}

model Revenue {
  id          String      @id @default(uuid())
  companyId   String
  bookingId   String
  currencyId  String
  type        RevenueType
  grossAmount Int
  netAmount   Int
  description String?     @db.VarChar(500)
  entryDate   DateTime    @default(now())
  createdById String
  version     Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  company   Company  @relation(fields: [companyId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])
  currency  Currency @relation(fields: [currencyId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, entryDate])
  @@index([bookingId])
  @@index([companyId, type])
  @@map("revenue")
}

model MCO {
  id          String    @id @default(uuid())
  companyId   String
  bookingId   String    @unique
  airlineId   String
  mcoNumber   String    @db.VarChar(50)
  amount      Int
  currencyId  String
  reason      String?   @db.VarChar(500)
  issuedAt    DateTime
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  booking  Booking  @relation(fields: [bookingId], references: [id])
  airline  Airline  @relation(fields: [airlineId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@index([companyId])
  @@map("mcos")
}

model Chargeback {
  id              String           @id @default(uuid())
  companyId       String
  bookingId       String
  cardProcessorId String
  amount          Int
  currencyId      String
  status          ChargebackStatus @default(OPEN)
  reason          String?          @db.VarChar(500)
  filedAt         DateTime         @default(now())
  resolvedAt      DateTime?
  createdById     String
  version         Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  booking       Booking       @relation(fields: [bookingId], references: [id])
  cardProcessor CardProcessor @relation(fields: [cardProcessorId], references: [id])
  currency      Currency      @relation(fields: [currencyId], references: [id])

  @@index([companyId])
  @@index([bookingId])
  @@index([companyId, status])
  @@map("chargebacks")
}

model Refund {
  id          String       @id @default(uuid())
  companyId   String
  bookingId   String
  amount      Int
  currencyId  String
  status      RefundStatus @default(PENDING)
  reason      String?      @db.VarChar(500)
  requestedAt DateTime     @default(now())
  processedAt DateTime?
  createdById String
  version     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  booking  Booking  @relation(fields: [bookingId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@index([companyId])
  @@index([bookingId])
  @@index([companyId, status])
  @@map("refunds")
}

model ActivityLog {
  id             String         @id @default(uuid())
  companyId      String
  actorId        String?
  actorName      String         @db.VarChar(200)
  action         ActivityAction
  entityType     String         @db.VarChar(50)
  entityId       String?
  entityLabel    String?        @db.VarChar(200)
  beforeSnapshot Json?
  afterSnapshot  Json?
  ipAddress      String?        @db.VarChar(45)
  userAgent      String?        @db.VarChar(500)
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([companyId, actorId])
  @@index([companyId, action])
  @@map("activity_logs")
}

model SecurityLog {
  id        String        @id @default(uuid())
  companyId String
  userId    String?
  event     SecurityEvent
  ipAddress String        @db.VarChar(45)
  userAgent String?       @db.VarChar(500)
  metadata  Json?
  createdAt DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, event])
  @@index([companyId, userId])
  @@map("security_logs")
}

model Notification {
  id          String               @id @default(uuid())
  companyId   String
  userId      String
  title       String               @db.VarChar(200)
  body        String               @db.VarChar(1000)
  severity    NotificationSeverity @default(INFO)
  sourceType  String?              @db.VarChar(50)
  sourceId    String?
  actionUrl   String?              @db.VarChar(500)
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model IPRule {
  id          String     @id @default(uuid())
  companyId   String
  type        IPRuleType
  cidr        String     @db.VarChar(50)
  description String?    @db.VarChar(300)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, type])
  @@map("ip_rules")
}

model Airline {
  id          String    @id @default(uuid())
  companyId   String?
  airlineName String    @db.VarChar(200)
  iataCode    String    @db.VarChar(3)
  icaoCode    String?   @db.VarChar(4)
  country     String    @db.VarChar(100)
  logoUrl     String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company?  @relation(fields: [companyId], references: [id])
  segments ItinerarySegment[]
  mcos     MCO[]

  @@index([companyId])
  @@index([iataCode])
  @@index([companyId, isActive])
  @@map("airlines")
}

model BookingClass {
  id        String    @id @default(uuid())
  companyId String?
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(5)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company?  @relation(fields: [companyId], references: [id])
  segments ItinerarySegment[]

  @@index([companyId])
  @@map("booking_classes")
}

model Provider {
  id        String    @id @default(uuid())
  companyId String?
  name      String    @db.VarChar(200)
  logoUrl   String?   @db.VarChar(500)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company?  @relation(fields: [companyId], references: [id])
  bookings Booking[]

  @@index([companyId])
  @@map("providers")
}

model CardProcessor {
  id        String    @id @default(uuid())
  companyId String?
  name      String    @db.VarChar(200)
  shortCode String?   @db.VarChar(10)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company?        @relation(fields: [companyId], references: [id])
  billingDetails BillingDetail[]
  chargebacks    Chargeback[]

  @@index([companyId])
  @@map("card_processors")
}

model Currency {
  id            String    @id @default(uuid())
  code          String    @unique @db.VarChar(3)
  name          String    @db.VarChar(100)
  symbol        String    @db.VarChar(5)
  decimalPlaces Int       @default(2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  charges     Charge[]
  revenue     Revenue[]
  mcos        MCO[]
  chargebacks Chargeback[]
  refunds     Refund[]

  @@map("currencies")
}

model CallQueue {
  id          String    @id @default(uuid())
  companyId   String
  name        String    @db.VarChar(200)
  phone       String?   @db.VarChar(30)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  bookings Booking[]

  @@index([companyId])
  @@map("call_queues")
}

model SavedView {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  tableKey  String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  filters   Json
  sortBy    String?  @db.VarChar(50)
  sortDir   String?  @db.VarChar(4)
  columns   Json?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, tableKey])
  @@map("saved_views")
}

model BookingNote {
  id        String    @id @default(uuid())
  bookingId String
  userId    String
  note      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@map("booking_notes")
}

// Personal, page-agnostic notes created from the global "Quick Notes" floating
// widget. Deliberately independent of Booking — scoped to the authenticated
// user (and their company, for tenancy consistency with every other model),
// never to a specific booking. Coexists with BookingNote; neither references
// the other.
model QuickNote {
  id        String    @id @default(uuid())
  companyId String
  userId    String
  note      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([userId, createdAt])
  @@map("quick_notes")
}
