# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://crm_user:crm_pass@localhost:5432/crm_db?schema=public

# JWT
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=10
