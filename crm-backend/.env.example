# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://crm_user:crm_pass@localhost:5432/crm_db?schema=public

# JWT
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=10

# Email (booking verification) — SMTP. Leave unset locally and the backend
# logs verification emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=BookingCRM <no-reply@yourdomain.com>

# Base URL of the deployed frontend — used to build the client verification link
FRONTEND_URL=http://localhost:3000
VERIFICATION_EXPIRY_HOURS=168
